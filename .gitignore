.DS_Store
node_modules/
.env
.env.*
!.env.example
*.log
__pycache__/
*.pyc

# Saídas pessoais de quem usa: currículo gerado por vaga, materiais colados,
# rascunhos. Nada disso é do projeto.
/Curriculo/
/Skills/adapt-resume/materiais-fonte/*
!/Skills/adapt-resume/materiais-fonte/README.md
/Skills/adapt-resume/builds/*
!/Skills/adapt-resume/builds/.gitkeep
/Skills/adapt-resume/base_resume_*.pdf
# Só os adaptadores públicos de skills entram; configurações locais continuam fora.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/onboarding/
!/.claude/skills/coletar/
!/.claude/skills/aplicar/
/.claude/skills/onboarding/*
/.claude/skills/coletar/*
/.claude/skills/aplicar/*
!/.claude/skills/onboarding/SKILL.md
!/.claude/skills/coletar/SKILL.md
!/.claude/skills/aplicar/SKILL.md

/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/onboarding/
!/.agents/skills/coletar/
!/.agents/skills/aplicar/
/.agents/skills/onboarding/*
/.agents/skills/coletar/*
/.agents/skills/aplicar/*
!/.agents/skills/onboarding/SKILL.md
!/.agents/skills/coletar/SKILL.md
!/.agents/skills/aplicar/SKILL.md

# Visualização pessoal das respostas de candidaturas; não publicar.
/revisoes/

# Ajuste opcional próprio da instalação; o padrão vive no código.
/vagas/config/navegador.json
/interface/.env.example
