# Optional: connect to the existing local JobRelay API.
# Leave unset to use five fictional examples, held only in memory.
# Only HTTP localhost or 127.0.0.1 origins are accepted.
# JOBRELAY_API_URL=http://127.0.0.1:4182

# Visual prototype only: private JSON copy of selected jobs, outside this checkout.
# Status movements persist here; this never synchronizes with Notion.
# JOBRELAY_PROTOTYPE_FILE=/absolute/private/path/quadro-teste.json
# After building, pnpm start loads .env.local and serves on 127.0.0.1:4186.
